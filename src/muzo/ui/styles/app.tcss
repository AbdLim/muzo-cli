/* Muzo Terminal Application Stylesheet */

Screen {
    background: #14171a;
    color: #c4c9d0;
    layout: vertical;
}

#header {
    dock: top;
    height: 1;
    width: 100%;
    background: #191d22;
    color: #7e8a97;
    padding: 0 1;
}

#header-title {
    color: #7eb6ad;
    text-style: bold;
}

#header-sep {
    color: #3e4854;
}

#header-status {
    color: #7e8a97;
}

#scene-container {
    width: 100%;
    height: 1fr;
    background: transparent;
}

#footer {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #191d22;
    color: #7e8a97;
    padding: 0 1;
}

.footer-key {
    color: #7eb6ad;
    text-style: bold;
}

.footer-label {
    color: #7e8a97;
}

/* Help Overlay Modal */
HelpScreen {
    align: center middle;
    background: rgba(14, 17, 20, 0.75);
}

#help-dialog {
    width: 56;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: #1c2128;
    border: round #7eb6ad;
    padding: 1 2;
}

#help-title {
    color: #7eb6ad;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#help-body {
    color: #c4c9d0;
    margin-bottom: 1;
}

#help-footer {
    color: #7e8a97;
    text-align: center;
}
