/* Muzo Terminal Application Stylesheet */

Screen {
    background: #14171a;
    color: #c4c9d0;
    layout: vertical;
}

#header {
    dock: top;
    height: 1;
    width: 100%;
    background: #191d22;
    color: #7e8a97;
    padding: 0 1;
}

#header-title {
    color: #7eb6ad;
    text-style: bold;
}

#header-sep {
    color: #3e4854;
}

#header-status {
    color: #7e8a97;
}

#scene-view {
    width: 100%;
    height: 1fr;
    background: transparent;
}

#player-status {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #171b20;
    color: #7e8a97;
    padding: 0 1;
}

#footer {
    dock: bottom;
    height: 1;
    width: 100%;
    background: #191d22;
    color: #7e8a97;
    padding: 0 1;
}

/* Help Overlay Modal */
HelpScreen {
    align: center middle;
    background: rgba(14, 17, 20, 0.75);
}

#help-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: #1c2128;
    border: round #7eb6ad;
    padding: 1 2;
}

#help-title {
    color: #7eb6ad;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#help-body {
    color: #c4c9d0;
    margin-bottom: 1;
}

#help-footer {
    color: #7e8a97;
    text-align: center;
}

/* Station Picker Modal */
StationPickerScreen {
    align: center middle;
    background: rgba(14, 17, 20, 0.75);
}

#picker-dialog {
    width: 72;
    max-width: 92%;
    height: 22;
    max-height: 85%;
    background: #1c2128;
    border: round #7eb6ad;
    padding: 1 2;
    layout: vertical;
}

#picker-title {
    color: #7eb6ad;
    text-align: center;
    margin-bottom: 1;
}

#picker-moods {
    height: 1;
    margin-bottom: 1;
    text-align: center;
}

#picker-content {
    height: 1fr;
    background: #15181e;
    border: solid #283038;
}

#picker-status {
    height: 1fr;
    content-align: center middle;
    text-align: center;
    padding: 1;
}

#picker-options {
    height: 1fr;
    background: transparent;
}

#picker-footer {
    height: 1;
    text-align: center;
    margin-top: 1;
}

/* Focus Mode: maximize scene view and hide surrounding chrome */
.focus-mode #header {
    display: none;
}

.focus-mode #player-status {
    display: none;
}

.focus-mode #footer {
    display: none;
}

/* Scene Picker Modal */
ScenePickerScreen {
    align: center middle;
    background: rgba(14, 17, 20, 0.75);
}

#scene-picker-dialog {
    width: 74;
    max-width: 94%;
    height: 18;
    max-height: 85%;
    background: #1c2128;
    border: round #7eb6ad;
    padding: 1 2;
    layout: vertical;
}

#scene-picker-title {
    color: #7eb6ad;
    text-align: center;
    margin-bottom: 1;
}

#scene-picker-content {
    height: 1fr;
    background: #15181e;
    border: solid #283038;
}

#scene-picker-options {
    height: 1fr;
    background: transparent;
}

#scene-picker-footer {
    height: 1;
    text-align: center;
    margin-top: 1;
}

